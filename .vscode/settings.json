{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[astro]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[markdown]": { "editor.defaultFormatter": "oxc.oxc-vscode" },

  "oxc.lint.run": "onType",
  "oxc.enable": true,
  "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" },

  "js/ts.tsdk.path": "node_modules/typescript/lib",

  // Tailwind v4 lives in CSS, so teach the extension where to look.
  "files.associations": { "*.css": "tailwindcss" },
  "tailwindCSS.experimental.configFile": "src/styles/global.css",
  "tailwindCSS.includeLanguages": { "astro": "html" },
  "editor.quickSuggestions": { "strings": true },

  "search.exclude": {
    "**/dist": true,
    "**/.astro": true,
    "**/node_modules": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "bun.lock": true
  },
  "files.exclude": { "**/.DS_Store": true }
}
