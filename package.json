{
  "name": "tayles-www",
  "version": "1.0.0",
  "private": true,
  "description": "tayles.co.uk homepage",
  "author": {
    "name": "David Taylor",
    "email": "hello@tayles.co.uk",
    "url": "https://tayles.co.uk"
  },
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "bun run sync && bun run fmt && bun run lint && bun run typecheck",
    "check:ci": "bun run sync && bun run fmt && bun run lint --format=github && bun run typecheck",
    "clean": "bun run fmt:fix && bun run lint:fix",
    "designs:md": "bun run scripts/generate-designs-md.ts",
    "dev": "astro dev",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "bun run lint --fix",
    "preview": "astro preview",
    "screenshots": "bun run scripts/capture-screenshots.ts",
    "start": "astro dev",
    "sync": "astro sync",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "astro check",
    "verify": "bun run check && bun run build && bun run test",
    "verify:ci": "bun run check:ci && bun run build && bun run test"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "19",
    "react-dom": "19",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "gray-matter": "^4.0.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sharp": "^0.35.4",
    "typescript": "6.0.3"
  }
}
