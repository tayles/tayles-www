---
import DesignShell from '@/components/DesignShell.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  designHref,
  getDesignComponent,
  getLatestDesign,
  getSocialImage,
} from '@/lib/designs';

// The homepage is always the newest design. It keeps its own permanent URL
// too, which is where the canonical points.
const latest = await getLatestDesign();
const Design = getDesignComponent(latest.id);
const ogImage = await getSocialImage(latest.id);
---

<BaseLayout
  title="David Taylor"
  description={latest.data.description}
  canonical={designHref(latest.id)}
  ogImage={ogImage}
  ogImageAlt={`The ${latest.data.name} design`}
>
  <DesignShell slug={latest.id}>
    <Design />
  </DesignShell>
</BaseLayout>
