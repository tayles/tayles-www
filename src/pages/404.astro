---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLatestSocialImage } from '@/lib/designs';

const ogImage = await getLatestSocialImage();
---

<BaseLayout title="Not found" ogImage={ogImage}>
  <main class="grid min-h-dvh place-items-center px-6 text-center">
    <div>
      <p class="text-muted-foreground font-mono text-sm">404</p>
      <h1 class="mt-3 text-5xl font-semibold tracking-tight sm:text-6xl">
        tayles
      </h1>
      <p class="text-muted-foreground mt-4">
        Nothing lives at this address.
      </p>
      <div class="mt-8 flex justify-center gap-6 text-sm">
        <a class="hover:text-foreground underline underline-offset-4" href="/"
          >Homepage</a
        >
        <a
          class="hover:text-foreground underline underline-offset-4"
          href="/designs">All designs</a
        >
      </div>
    </div>
  </main>
</BaseLayout>
